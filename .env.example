# The address the site is published at; the link-preview tags, the canonical link, the sitemap and the structured data need it.
VITE_SITE_URL=https://tinylittleoffice.com/
# More names the dev server answers to, comma-separated (pefdev.exe.xyz and localhost always do).
# VITE_ALLOWED_HOSTS=
# The link shortener on this machine (npm run tinier:dev), reached through the dev server; put this in .env.development.
# VITE_TINIER=/tinier/
# The short-link service (tinier/) a production build uses, when it is not tinier.tinylittleoffice.com (docs/self-host.md).
# VITE_TINIER=https://tinier.tinylittleoffice.com/
# A Spaces build (VITE_SPACES=1): documents kept in atproto spaces, signed in, with versions. Its connect-src is any
# https address, so it is served from an origin of its own and never deployed to the site (scripts/check-build.ts).
# VITE_SPACES=1
# The deploy's credentials (scripts/deploy.mjs), on a machine that deploys: an account API token for Workers Scripts,
# D1 and Account Settings, and Workers Routes and Zone Read on the zone; the account's id; an npm token to publish
# the command line. On GitHub they are the repository's secrets (.github/workflows/deploy.yml). Never committed.
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# NPM_TOKEN=
